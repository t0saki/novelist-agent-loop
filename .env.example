# 复制为 .env 后填写。值都不带引号。
# Postgres 密码（v1 已有则沿用 v1 的值）
NOVELIST_PG_PASSWORD=
# 账号凭据的主密钥（64 位 hex，openssl rand -hex 32）。留空则生成到 /data/.master_key。务必单独备份。
NOVELIST_MASTER_KEY=
# 管理员密码；留空时首次启动生成随机密码并打印到日志
NOVELIST_ADMIN_PASSWORD=
# 会话签名密钥；留空则持久化到 /data/.session_secret
NOVELIST_SESSION_SECRET=
# 主机端口（默认 8199；与 v1 并行时改成别的端口）
NOVELIST_PORT=8199
# 隔离档：auto（默认，容器内选 container，探测成功时用 bwrap）| container | bwrap | degraded
NOVELIST_ISOLATION=auto
